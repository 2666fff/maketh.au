[Unit]
Description=Deliver Maketh main-website quote notifications
After=postfix.service

[Service]
Type=oneshot
User=www
Group=www
UMask=0077
ExecStart=/www/server/php/84/bin/php /www/wwwroot/maketh.au/scripts/send-quote-notifications.php
TimeoutStartSec=120
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
